config.ini
window_state.json
channels.json
kick_channel_ids.json

# Cookies (sensitive — never commit!)
cookies.txt
cookies*.txt
*.har
.env
run_msr.local.bat

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.spec
.venv/
venv/

# Disk-space write probe (only appears if streams_dir is the repo folder)
.msr_write_probe
.msr_instance.lock
msr_update_error.txt

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
# Note: console captures are often saved as .txt, which *.log does not
# match — hence the explicit entries below.
*.log
*.log.[0-9]
stream_recorder.log*
console_log.txt
log_output*.txt

# Cross-process log rotation lock
*.rotating

# Version history of channels.json / config.ini (Restore previous...)
msr_history/

# Remembered video lengths for the Library window (Count hours)
library_cache.json
library_cache.json.tmp
library_actions.log
library_moves.json
library_moves.json.tmp
